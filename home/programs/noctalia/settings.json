      ],
      "right": [
        {
          "id": "CustomButton",
          "icon": "git-branch",
          "showIcon": true,
          "textCommand": "",
          "generalTooltipText": "System Architecture & Topology",
          "showExecTooltip": false,
          "leftClickExec": "bash -c 'nohup /home/ducson/.config/noctalia/scripts/system-tree.sh >/dev/null 2>&1 &'"
        },
        {
          "id": "SystemMonitor",
          "compactMode": true,
          "showCpuUsage": true,
          "showMemoryUsage": false,
          "showCpuTemp": false
        },
        {
          "id": "Volume",
          "displayMode": "onhover"
        },
        {
          "id": "Clock",
          "formatHorizontal": "HH:mm  ·  ddd, MMM dd"
        },
        {
          "id": "ControlCenter",
          "icon": "noctalia"
        }
      ]
    }
