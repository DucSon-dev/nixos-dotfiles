    "clockStyle": "minimal",
    "compactLockScreen": true,
    "dimmerOpacity": 0.0,
    "enableBlurBehind": true,
    "enableLockScreenCountdown": false,
    "enableLockScreenMediaControls": false,
    "enableShadows": true,
    "forceBlackScreenCorners": false,
    "iRadiusRatio": 1.1,
    "lockOnSuspend": true,
