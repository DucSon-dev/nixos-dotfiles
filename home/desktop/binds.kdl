binds {
    // ==========================================
    // 1. APPLICATION LAUNCHERS (MNEMONIC)
    // ==========================================
    Mod+T { spawn "kitty"; }            // [T]erminal
    Mod+B { spawn "brave"; }          // [B]rowser
    Mod+D { spawn "fuzzel"; }           // [D]rawer / App Launcher
    Mod+Return { spawn "kitty"; }       // Standard fallback for Terminal
    Mod+Slash { spawn "bash" "/home/ducson/.config/noctalia/scripts/cheatsheet.sh"; } // [?] Cheat Sheet
    Mod+G { spawn "kitty" "--class" "git-tree-float" "--directory" "/etc/nixos" "-e" "lazygit"; }
   
   

    // ==========================================
    // 2. WINDOW LIFECYCLE & STATE
    // ==========================================
    Mod+Q { close-window; }                 // [Q]uit window
    Mod+F { maximize-column; }              // [F]it/Maximize column
    Mod+Shift+F { fullscreen-window; }      // True [F]ullscreen
    Mod+C { center-column; }                // [C]enter focused column
    Mod+Space { toggle-overview; }          // Space Overview mode

    // ==========================================
    // 3. UTILITIES & SCREENSHOT
    // ==========================================
    Mod+S { screenshot; }                   // [S]creenshot interactive UI
    Mod+Shift+S { screenshot-screen; }      // [S]creenshot full screen
    Print { screenshot; }

    // ==========================================
    // 4. NAVIGATION (ARROWS & VIM HJKL)
    // ==========================================
    Mod+Left  { focus-column-left; }
    Mod+Right { focus-column-right; }
    Mod+Up    { focus-window-up; }
    Mod+Down  { focus-window-down; }

    Mod+H     { focus-column-left; }
    Mod+L     { focus-column-right; }
    Mod+K     { focus-window-up; }
    Mod+J     { focus-window-down; }

    // Multi-monitor navigation
    Mod+Shift+Left  { focus-monitor-left; }
    Mod+Shift+Right { focus-monitor-right; }
    Mod+Ctrl+Left   { move-column-to-monitor-left; }
    Mod+Ctrl+Right  { move-column-to-monitor-right; }

    // ==========================================
    // 5. MOVING & REORDERING COLUMNS
    // ==========================================
    Mod+Shift+H     { move-column-left; }
    Mod+Shift+L     { move-column-right; }
    Mod+Shift+K     { move-window-up; }
    Mod+Shift+J     { move-window-down; }

    // ==========================================
    // 6. WORKSPACES (1 - 9)
    // ==========================================
    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }

    Mod+Shift+1 { move-window-to-workspace 1; }
    Mod+Shift+2 { move-window-to-workspace 2; }
    Mod+Shift+3 { move-window-to-workspace 3; }
    Mod+Shift+4 { move-window-to-workspace 4; }

    // ==========================================
    // 7. SYSTEM & POWER
    // ==========================================
    Mod+Shift+E { quit; }                   // [E]xit session
}
