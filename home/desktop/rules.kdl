// ==============================================================================
// NIRI WINDOW RULES & LIQUID GLASS SPECIFICATION
// ==============================================================================

// 1. Global Window Geometry & Optical Glass Boundary
window-rule {
    geometry-corner-radius 16
    clip-to-geometry true
    draw-border-with-background false
}

// 2. shadcn Layout Discipline & Specular Focus Ring
layout {
    gaps 14
    border {
        off
    }
    focus-ring {
        width 2
        active-color "#ffffff28"
        inactive-color "#ffffff08"
    }
}

// 3. Floating Overlay Overrides for LazyGit & Modal Shells
window-rule {
    match app-id="^git-tree-float$"
    open-floating true
    default-column-width { proportion 0.85; }
    default-window-height { proportion 0.85; }
}
