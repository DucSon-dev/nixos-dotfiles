// ==============================================================================
// NIRI WINDOW RULES & LIQUID GLASS SPECIFICATION
// ==============================================================================

// 1. Global Window Geometry & Optical Glass Boundary
window-rule {
    geometry-corner-radius 16
    clip-to-geometry true
    draw-border-with-background false
}

// 2. shadcn Layout Discipline & Specular Focus Ring
layout {
    gaps 14
    border {
        off
    }
    focus-ring {
        width 2
        active-color "#ffffff28"
        inactive-color "#ffffff08"
    }
}

// 3. Floating Overlay Overrides for LazyGit & Modal Shells
window-rule {
    match app-id="^git-tree-float$"
    open-floating true
    default-column-width { proportion 0.85; }
    default-window-height { proportion 0.85; }
}

// 4. Music Player (Amberol) Compact Column Rule
window-rule {
    match app-id="^io.bassi.Amberol$"
    default-column-width { proportion 0.35; }
}

// 5. Floating Music Fetcher Dialog
window-rule {
    match app-id="^music-fetch-float$"
    open-floating true
    default-column-width { proportion 0.55; }
    default-window-height { proportion 0.48; }
}


// Anki Window Rules
window-rule {
    match app-id="^anki$"
    default-column-width { proportion 0.65; }
}

// Float dialogs and subwindows in Anki
window-rule {
    match app-id="^anki$" title="^Add$"
    open-floating true
}

window-rule {
    match app-id="^anki$" title="^Edit Current$"
    open-floating true
}

// Antigravity IDE Window Rule
window-rule {
    match app-id="^antigravity(-ide)?$"
    default-column-width { proportion 0.85; }
    geometry-corner-radius 16
    clip-to-geometry true
}

// FluentFlyout Manager Standalone Window Rule
window-rule {
    match app-id="^quickshell$" title="^FluentFlyout Manager$"
    open-floating true
    default-column-width { fixed 480; }
    default-window-height { fixed 540; }
}
