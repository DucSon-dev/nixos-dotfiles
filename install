#!/usr/bin/env bash
# ==============================================================================
# Universal NixOS + Niri + Noctalia Automated Installer & Deployer
# Supported Targets: Bare-metal Live ISO and Running System Bootstrap
# ==============================================================================

set -euo pipefail

# UI Color Codes
RED='\033[0;31m'
GREEN='\033[0;32m'
BLUE='\033[0;34m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
BOLD='\033[1m'
NC='\033[0m'

info()    { echo -e "${BLUE}[INFO]${NC} $*"; }
warn()    { echo -e "${YELLOW}[WARN]${NC} $*"; }
error()   { echo -e "${RED}[ERROR]${NC} $*"; exit 1; }
ok()      { echo -e "${GREEN}[OK]${NC} $*"; }
section() { echo -e "\n${BOLD}${CYAN}=== $* ===${NC}"; }

# ------------------------------------------------------------------------------
# 1. PRE-FLIGHT CHECKS & HARDWARE PROFILING
# ------------------------------------------------------------------------------
section "Phase 1: Pre-flight Verification & Hardware Discovery"

if [[ $EUID -ne 0 ]]; then
    error "This installer must be run with superuser privileges (sudo or root)!"
fi

if [[ ! -d /sys/firmware/efi ]]; then
    error "Legacy BIOS detected! Modern Wayland / Niri strictly requires UEFI mode."
fi
ok "UEFI boot environment confirmed."

if ! ping -c 1 -W 3 1.1.1.1 &>/dev/null; then
    error "No active Internet connection! Connect via NetworkManager (nmtui / nmcli) first."
fi
ok "Network connectivity verified."

CPU_VENDOR=$(grep -m1 "vendor_id" /proc/cpuinfo | awk '{print $3}')
TOTAL_MEM=$(free -h | awk '/^Mem:/ {print $2}')
DETECTED_GPU=$(cat /sys/class/drm/card*/device/uevent 2>/dev/null | grep "DRIVER=" | head -n1 | cut -d= -f2 || echo "Generic")

info "Detected CPU Platform : ${CPU_VENDOR}"
info "Detected GPU Driver   : ${DETECTED_GPU}"
info "Total Physical Memory : ${TOTAL_MEM}"

# ------------------------------------------------------------------------------
# 2. RUNTIME MODE DETECTION
# ------------------------------------------------------------------------------
section "Phase 2: Execution Environment Assessment"

IS_LIVE_ISO=false
if grep -q "nixos-installer" /etc/os-release 2>/dev/null || grep -q "iso" /proc/cmdline 2>/dev/null || [[ -d /nix/.ro-store ]]; then
    IS_LIVE_ISO=true
    info "Environment: [Live USB Media] -> Full Clean Bare-Metal Installation mode"
else
    info "Environment: [Existing NixOS System] -> Local Rebuild & Configuration switch"
fi

# ------------------------------------------------------------------------------
# 3. USER CONFIGURATION PROMPTS
# ------------------------------------------------------------------------------
section "Phase 3: System Identity Configuration"

DEFAULT_USER="${SUDO_USER:-d6n}"
DEFAULT_HOST="nixos"

read -rp "Enter target Hostname [default: ${DEFAULT_HOST}]: " INPUT_HOST
TARGET_HOST="${INPUT_HOST:-$DEFAULT_HOST}"

read -rp "Enter primary Username [default: ${DEFAULT_USER}]: " INPUT_USER
TARGET_USER="${INPUT_USER:-$DEFAULT_USER}"

echo ""
info "Deployment Hostname : ${BOLD}${TARGET_HOST}${NC}"
info "Deployment Username : ${BOLD}${TARGET_USER}${NC}"

# ------------------------------------------------------------------------------
# 4. DISK PARTITIONING & FORMATTING (Live USB Mode Only)
# ------------------------------------------------------------------------------
TARGET_ROOT="/mnt"

if [ "$IS_LIVE_ISO" = true ]; then
    section "Phase 4: Storage Partitioning & Mount Setup"
    
    echo "Available Storage Disks:"
    lsblk -d -p -n -l -o NAME,SIZE,MODEL,TYPE | grep "disk"
    echo ""

    read -rp "Enter target disk path to erase and format (e.g., /dev/nvme0n1 or /dev/sda): " TARGET_DISK

    if [[ ! -b "$TARGET_DISK" ]]; then
        error "Device '$TARGET_DISK' is invalid or not a block device!"
    fi

    echo -e "\n${RED}⚠️  DANGER ZONE: ALL DATA ON ${TARGET_DISK} WILL BE COMPLETELY WIPED! ⚠️${NC}"
    read -rp "Type 'yes' to proceed with irreversible disk partition: " CONFIRM_WIPE
    if [[ "$CONFIRM_WIPE" != "yes" ]]; then
        error "Operation aborted by user."
    fi

    info "Clearing existing mounts on ${TARGET_DISK}..."
    umount -R /mnt 2>/dev/null || true
    swapoff -a 2>/dev/null || true

    info "Creating GPT layout (1GiB EFI System Partition + 100% Ext4 Root)..."
    parted --script "$TARGET_DISK" -- \
        mklabel gpt \
        mkpart ESP fat32 1MiB 1025MiB \
        set 1 esp on \
        mkpart primary 1025MiB 100%

    if [[ "$TARGET_DISK" =~ (nvme|mmcblk|loop) ]]; then
        PART_BOOT="${TARGET_DISK}p1"
        PART_ROOT="${TARGET_DISK}p2"
    else
        PART_BOOT="${TARGET_DISK}1"
        PART_ROOT="${TARGET_DISK}2"
    fi

    udevadm settle
    sleep 2

    info "Formatting partitions (FAT32 for EFI, Ext4 for NixOS root)..."
    mkfs.fat -F 32 -n BOOT "$PART_BOOT"
    mkfs.ext4 -F -L nixos "$PART_ROOT"

    info "Mounting destination filesystems to ${TARGET_ROOT}..."
    mkdir -p "$TARGET_ROOT"
    mount /dev/disk/by-label/nixos "$TARGET_ROOT"
    mkdir -p "${TARGET_ROOT}/boot"
    mount /dev/disk/by-label/BOOT "${TARGET_ROOT}/boot"

    ok "Storage layout successfully prepared and mounted."

    info "Probing target hardware specs via nixos-generate-config..."
    nixos-generate-config --root "$TARGET_ROOT"

    REPO_DEST="${TARGET_ROOT}/etc/nixos"
else
    REPO_DEST="/etc/nixos"
fi

# ------------------------------------------------------------------------------
# 5. REPOSITORY SYNCHRONIZATION & VARIABLE INJECTION
# ------------------------------------------------------------------------------
section "Phase 5: Configuration Injection & Customization"

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

info "Syncing repository files into ${REPO_DEST}..."
mkdir -p "${REPO_DEST}"

if [ "$SCRIPT_DIR" != "$REPO_DEST" ]; then
    cp -r "${SCRIPT_DIR}/." "${REPO_DEST}/"
fi

if [ "$IS_LIVE_ISO" = true ]; then
    info "Relocating generated hardware-configuration.nix into hosts/${TARGET_HOST}/..."
    mkdir -p "${REPO_DEST}/hosts/${TARGET_HOST}"
    if [ -f "${TARGET_ROOT}/etc/nixos/hardware-configuration.nix" ]; then
        mv "${TARGET_ROOT}/etc/nixos/hardware-configuration.nix" "${REPO_DEST}/hosts/${TARGET_HOST}/hardware-configuration.nix"
    fi
fi

# Dynamically handle GPU drivers in system.nix based on detected hardware
if [ "$IS_LIVE_ISO" = true ]; then
    SYS_NIX="${REPO_DEST}/hosts/${TARGET_HOST}/system.nix"
    if [ -f "$SYS_NIX" ]; then
        if [[ "$DETECTED_GPU" == "i915" ]] || [[ "$DETECTED_GPU" == "xe" ]]; then
            info "Optimizing GPU configuration for Intel Graphics..."
            sed -i 's/"amdgpu"/"i915"/g' "$SYS_NIX"
        elif [[ "$DETECTED_GPU" == "nouveau" ]] || [[ "$DETECTED_GPU" == "nvidia" ]]; then
            info "Nvidia GPU detected. Removing hardcoded amdgpu drivers..."
            sed -i 's/services.xserver.videoDrivers = \[ "amdgpu" \];/# Handled dynamically/g' "$SYS_NIX"
        fi
    fi
fi

# Declaratively update centralized variables in flake.nix
info "Updating centralized variables in flake.nix..."
sed -i -E "s/username = \".*\"/username = \"${TARGET_USER}\"/" "${REPO_DEST}/flake.nix"
sed -i -E "s/hostname = \".*\"/hostname = \"${TARGET_HOST}\"/" "${REPO_DEST}/flake.nix"

# ------------------------------------------------------------------------------
# 6. SYSTEM BUILD & ACTIVATION
# ------------------------------------------------------------------------------
section "Phase 6: Compilation & System Activation"

cd "${REPO_DEST}"
git config --global --add safe.directory "${REPO_DEST}" 2>/dev/null || true
git add . 2>/dev/null || true

if [ "$IS_LIVE_ISO" = true ]; then
    info "Compiling NixOS system closure via nixos-install..."
    nixos-install --flake ".#${TARGET_HOST}"

    section "Phase 7: Account Security"
    info "Setting custom password for user: ${TARGET_USER}"
    nixos-enter --root "$TARGET_ROOT" -c "passwd ${TARGET_USER}"

    echo -e "\n${GREEN}================================================================${NC}"
    echo -e "${GREEN}✔ NixOS + Niri + Noctalia installed successfully!${NC}"
    echo -e "You may now remove the USB drive and run: ${BOLD}${CYAN}reboot${NC}"
    echo -e "${GREEN}================================================================${NC}"
else
    info "Rebuilding system generation with nixos-rebuild switch..."
    nixos-rebuild switch --flake ".#${TARGET_HOST}"

    section "Phase 7: Account Security Verification"
    USER_SHADOW_STATUS=$(passwd -S "${TARGET_USER}" 2>/dev/null | awk '{print $2}' || echo "L")
    if [[ "$USER_SHADOW_STATUS" == "L" ]] || [[ "$USER_SHADOW_STATUS" == "NP" ]] || [[ "$USER_SHADOW_STATUS" == "" ]]; then
        warn "User '${TARGET_USER}' requires a password update. Please enter password:"
        passwd "${TARGET_USER}"
    else
        ok "Password for user '${TARGET_USER}' is active."
    fi

    ok "NixOS environment updated and reloaded successfully!"
fi
